# Avoid recording tokens or PII embedded in query strings in access logs.
log_format clinic_safe '$remote_addr $request_method $uri $status $body_bytes_sent';
access_log /var/log/nginx/access.log clinic_safe;

# Production HTTPS mode. Issuing a cert via ACME webroot is a PRECONDITION.
server {
    listen 80;
    server_name ${DUCKDNS_FQDN};
    server_tokens off;

    location = /__health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${DUCKDNS_FQDN};
    server_tokens off;
    client_max_body_size 20m;

    ssl_certificate /etc/letsencrypt/live/${DUCKDNS_FQDN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DUCKDNS_FQDN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;

    location = /__health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Both webhook endpoints are proxied without path rewrite or redirects.
    #   POST /pagos/stripe/webhook
    #   POST /pagos/resend/webhook
    location / {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
