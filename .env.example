# EXAMPLE ONLY. Never commit an actual .env or credentials.
# Local smoke MUST use .env.docker-smoke, not production connections.
APP_ENV=production
APP_TIMEZONE=America/La_Paz

# SaaS control plane / legacy database. Tenant DB names are server-resolved.
# A Supabase connection must be reachable from EC2, with SSL enabled.
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@SUPABASE_HOST:5432/postgres?sslmode=require
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_URL_BASE=https://clinica-oftalmologica-web.vercel.app/password/restablecer

# These variables are REQUIRED by app/core/config.py at startup.
GMAIL_CLIENT_ID=REPLACE
GMAIL_CLIENT_SECRET=REPLACE
GMAIL_REFRESH_TOKEN=REPLACE
GMAIL_SENDER_EMAIL=REPLACE

# Stripe TEST mode only. Never use a live secret for university demonstrations.
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_AWS_ENDPOINT_SECRET
STRIPE_CURRENCY=bob

# Resend demonstration (authorized test recipient only).
RESEND_API_KEY=REPLACE
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Clinica Oftalmologica
RESEND_WEBHOOK_SECRET=REPLACE_WITH_RESEND_SIGNING_SECRET
RESEND_DEMO_MODE=true
EMAIL_TEST=REPLACE_WITH_AUTHORIZED_TEST_EMAIL
RESEND_TIMEOUT_SECONDS=15
RESEND_WORKER_BATCH_SIZE=20
RESEND_WORKER_INTERVAL_SECONDS=15

# Backups: private local staging, optional private Supabase Storage destination.
SAAS_BACKUP_PRIVATE_DIR=/opt/app/private-backups
SAAS_BACKUP_STORAGE_PROVIDER=local
# For AWS production use the dedicated PRIVATE bucket option, after validation.
SAAS_BACKUP_SUPABASE_URL=
SAAS_BACKUP_SUPABASE_BUCKET=
SAAS_BACKUP_SUPABASE_SERVICE_ROLE_KEY=
SAAS_BACKUP_SUPABASE_PUBLIC=false
# SAAS_BACKUP_PG_BIN_DIR=/usr/bin

# Optional services; do not populate with live keys if not used.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Clinica Oftalmologica
SMTP_USE_TLS=true

# Docker Compose / Nginx options (not passed as secrets to Nginx).
DOCKER_IMAGE_TAG=local
HTTP_PORT=80
HTTPS_PORT=443
NGINX_MODE=http
DUCKDNS_FQDN=REPLACE_WITH_SUBDOMAIN.duckdns.org
