# Plantilla del worker FCM. Copiar a .env.fcm-worker en EC2 y proteger con chmod 600.
# No poner aquí credenciales AWS: el worker obtiene credenciales temporales desde IMDSv2.
APP_ENV=production
APP_TIMEZONE=America/La_Paz

# El proceso importa configuración común del backend; estos valores son obligatorios
# por las validaciones actuales de app/core/config.py aunque el worker FCM no use Gmail.
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@SUPABASE_HOST:5432/postgres?sslmode=require
JWT_SECRET_KEY=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_URL_BASE=https://clinica-oftalmologica-web.vercel.app/password/restablecer
GMAIL_CLIENT_ID=VALOR_REAL_REQUERIDO_POR_CONFIGURACION_COMUN
GMAIL_CLIENT_SECRET=VALOR_REAL_REQUERIDO_POR_CONFIGURACION_COMUN
GMAIL_REFRESH_TOKEN=VALOR_REAL_REQUERIDO_POR_CONFIGURACION_COMUN
GMAIL_SENDER_EMAIL=CUENTA_REAL_REQUERIDA_POR_CONFIGURACION_COMUN

# Proyecto Firebase confirmado.
FCM_PROJECT_ID=clinica-oftalmologica-24ff7

# Parámetros del worker FCM.
PUSH_WORKER_INTERVAL_SECONDS=60
PUSH_WORKER_BATCH_SIZE=20
PUSH_WORKER_LEASE_SECONDS=120
PUSH_WORKER_TIMEOUT_SECONDS=10
PUSH_WORKER_MAX_CYCLE_SECONDS=90
PUSH_REMINDER_ANTICIPATIONS_MINUTES=1440,60
PUSH_REMINDER_GRACE_MINUTES=10
PUSH_REMINDER_TIMEZONE=America/La_Paz
LOG_LEVEL=INFO
